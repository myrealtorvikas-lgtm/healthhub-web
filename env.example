# Copy this file to `.env` for local testing (never commit the real `.env`).
# On Render, set these as Environment Variables in the dashboard instead of a file.

# A long random string used to sign session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-64-char-string

# Local dev defaults to a SQLite file. In production, Render will give you a
# Postgres connection string to put here instead, e.g.:
#   postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///healthhub.db

# Where uploaded export files are saved. Local dev default is fine; on a
# real host point this at persistent storage.
UPLOAD_FOLDER=./uploads
